# Cloudflare Pages — nunca cachear o "esqueleto" do app, para que toda
# atualização apareça na hora (os assets em /assets/ têm hash e podem cachear).
/index.html
  Cache-Control: no-cache, must-revalidate
/sw.js
  Cache-Control: no-cache, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
