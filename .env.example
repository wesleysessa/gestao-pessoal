# Google Health (ex-Fitbit) — Client ID é público. Criado em
# console.cloud.google.com > Google Auth Platform > Clientes. O Client
# Secret correspondente NUNCA entra aqui — fica só nos segredos da Edge
# Function (supabase secrets set).
VITE_GOOGLE_HEALTH_CLIENT_ID="SEU_CLIENT_ID.apps.googleusercontent.com"
VITE_GOOGLE_HEALTH_REDIRECT_URI="https://SEU-DOMINIO/fitbit-callback"
